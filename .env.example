# ChameleonNet Configuration Template

# Operational Mode
CHAMELEON_ENV=development

# LLM Provider: 'mock' (default offline), 'gemini', or 'claude'
LLM_PROVIDER=mock

# Live LLM API Keys (optional; only needed if LLM_PROVIDER is set to gemini or claude)
GEMINI_API_KEY=
CLAUDE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Service Ports
SSH_HOST=0.0.0.0
SSH_PORT=2222
WEB_HOST=0.0.0.0
WEB_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8500

# Initial Deception Profile
# Options: ubuntu_web_server, dev_workstation, database_host
DEFAULT_PROFILE=ubuntu_web_server

# Security & Containment
EGRESS_PROHIBITED=true
MAX_SESSION_DURATION_SECONDS=3600
RATE_LIMIT_COMMANDS_PER_MINUTE=60
